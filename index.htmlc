
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>손시후 | 자기소개</title>

  <style>
    /* 모든 요소의 크기 계산을 쉽게 설정 */
    * {
      box-sizing: border-box;
    }

    /* 페이지 전체 디자인 */
    body {
      margin: 0;
      min-height: 100vh;
      padding: 24px 16px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: -apple-system, BlinkMacSystemFont,
        "Apple SD Gothic Neo", "Malgun Gothic",
        sans-serif;
      background: linear-gradient(135deg, #e8f5e9, #f1f8e9);
      color: #26382b;
      overflow-wrap: break-word;
    }

    /* 자기소개 카드 */
    .profile-card {
      width: 100%;
      max-width: 380px;
      padding: 36px 24px;
      background-color: #ffffff;
      border-radius: 24px;
      text-align: center;
      box-shadow: 0 12px 35px rgba(50, 90, 55, 0.12);
    }

    /* 맨 위의 큰 이모지 */
    .emoji {
      font-size: 76px;
      line-height: 1.3;
      margin-bottom: 16px;
    }

    /* 이름 */
    h1 {
      margin: 0 0 12px;
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    /* 한 줄 소개 */
    .intro {
      margin: 0 auto 24px;
      color: #68776b;
      font-size: 15px;
      line-height: 1.8;
      word-break: keep-all;
    }

    /* 좋아하는 것 태그 영역 */
    .tags {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 28px;
    }

    /* 둥근 태그 */
    .tag {
      padding: 9px 16px;
      border-radius: 999px;
      background-color: #edf7ed;
      color: #397344;
      font-size: 14px;
      font-weight: 600;
    }

    /* 깃허브 링크 버튼 */
    .github-button {
      display: block;
      width: 100%;
      padding: 14px 20px;
      border-radius: 14px;
      background-color: #347a45;
      color: #ffffff;
      text-decoration: none;
      font-size: 16px;
      font-weight: 700;
      transition: background-color 0.2s;
    }

    .github-button:hover {
      background-color: #285f36;
    }

    .github-button:focus-visible {
      outline: 3px solid #9ac9a3;
      outline-offset: 4px;
    }

    /* 작은 휴대폰 화면 */
    @media (max-width: 360px) {
      .profile-card {
        padding: 30px 18px;
      }

      h1 {
        font-size: 27px;
      }

      .emoji {
        font-size: 66px;
      }
    }
  </style>
</head>

<body>
  <main class="profile-card">
    <div class="emoji" aria-hidden="true">🥬</div>

    <h1>손시후</h1>

    <p class="intro">
      공학과 식물을 좋아하는 고등학교 2학년입니다
    </p>

    <div class="tags" aria-label="좋아하는 것">
      <span class="tag">수학</span>
      <span class="tag">물리</span>
      <span class="tag">🌱 식물</span>
    </div>

    <a
      class="github-button"
      href="https://github.com/"
      target="_blank"
      rel="noopener noreferrer"
    >
      내 깃허브 ↗
    </a>
  </main>
</body>
</html>

/* D-day 상자 */
.dday-box {
  width: 100%;
  max-width: 380px;
  padding: 24px 20px;
  text-align: center;
  background: linear-gradient(135deg, #d8efda, #edf7ed);
  border: 1px solid #d0e8d2;
  border-radius: 24px;
  box-shadow: 0 8px 24px rgba(50, 90, 55, 0.08);
}

.dday-number {
  margin: 0 0 8px;
  color: #347a45;
  font-size: clamp(48px, 12vw, 68px);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -2px;
  font-variant-numeric: tabular-nums;
}

.dday-label {
  margin: 0;
  color: #58745c;
  font-size: 14px;
  font-weight: 600;
}

/* D-day와 기존 자기소개 카드를 세로로 배치 */
body {
  flex-direction: column;
  gap: 20px;
}

<!-- 나의 목표: 만다라트 목표판 -->
<section class="mandala-wrap">
  <h2 class="mandala-title">나의 목표</h2>
  <p class="mandala-guide">칸을 눌러서 고칠 수 있어요</p>

  <div class="mandala-grid" id="mandalaGrid">
    <div class="mandala-cell" contenteditable="true" data-index="0">매일 30분 영어 듣기</div>
    <div class="mandala-cell" contenteditable="true" data-index="1">국어 오답노트</div>
    <div class="mandala-cell" contenteditable="true" data-index="2">주 3회 운동</div>

    <div class="mandala-cell" contenteditable="true" data-index="3">독서 월 2권</div>
    <div class="mandala-cell mandala-center" contenteditable="true" data-index="4">전기정보공학 진학</div>
    <div class="mandala-cell" contenteditable="true" data-index="5">과학 동아리 발표</div>

    <div class="mandala-cell" contenteditable="true" data-index="6">7시간 수면</div>
    <div class="mandala-cell" contenteditable="true" data-index="7">봉사활동 20시간</div>
    <div class="mandala-cell" contenteditable="true" data-index="8">코딩 포트폴리오</div>
  </div>

  <p class="mandala-status" id="mandalaStatus" aria-live="polite">
    수정한 내용은 자동으로 저장돼요.
  </p>
</section>

<style>
  /* 만다라트 전체 영역 */
  .mandala-wrap {
    width: 100%;
    max-width: 540px;
    margin: 28px auto;
    padding: 0 12px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont,
      "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
    color: #26382b;
  }

  .mandala-wrap * {
    box-sizing: border-box;
  }

  .mandala-title {
    margin: 0 0 8px;
    text-align: center;
    font-size: 26px;
    font-weight: 800;
  }

  .mandala-guide {
    margin: 0 0 20px;
    text-align: center;
    color: #68776b;
    font-size: 14px;
  }

  /* 3×3 격자 */
  .mandala-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 7px;
    width: 100%;
  }

  /* 각 칸을 정사각형으로 설정 */
  .mandala-cell {
    aspect-ratio: 1 / 1;
    min-width: 0;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;

    background: #edf7ed;
    border: 1px solid #d5e9d5;
    border-radius: 12px;

    color: #397344;
    text-align: center;
    font-size: clamp(10px, 2.8vw, 15px);
    font-weight: 600;
    line-height: 1.5;

    overflow-wrap: anywhere;
    word-break: keep-all;
    white-space: pre-wrap;
    overflow: auto;
    cursor: text;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .mandala-cell:focus {
    outline: none;
    border: 2px solid #6aab76;
    background: #f7fcf7;
  }

  /* 가운데 핵심 목표 */
  .mandala-center {
    background: #347a45;
    border-color: #347a45;
    color: #ffffff;
    font-size: clamp(12px, 3.2vw, 17px);
    font-weight: 800;
    box-shadow: 0 4px 12px rgba(52, 122, 69, 0.2);
  }

  .mandala-center:focus {
    background: #285f36;
    border-color: #b4ddb9;
  }

  .mandala-status {
    margin: 14px 0 0;
    text-align: center;
    color: #68776b;
    font-size: 12px;
  }

  @media (max-width: 360px) {
    .mandala-grid {
      gap: 5px;
    }

    .mandala-cell {
      padding: 3px;
      border-radius: 8px;
      line-height: 1.4;
    }
  }
</style>

<script>
  (() => {
    const grid = document.getElementById("mandalaGrid");
    const status = document.getElementById("mandalaStatus");
    const cells = grid.querySelectorAll(".mandala-cell");

    // 저장할 때 사용할 고유 이름
    const storageKey = "myMandalaGoals_v1";

    // 저장된 목표 불러오기
    try {
      const saved = localStorage.getItem(storageKey);

      if (saved) {
        const goals = JSON.parse(saved);

        if (Array.isArray(goals) && goals.length === cells.length) {
          cells.forEach((cell, index) => {
            cell.textContent = goals[index];
          });
        }
      }
    } catch (error) {
      status.textContent = "저장된 내용을 불러오지 못했어요.";
    }

    // 칸의 내용을 저장하기
    function saveGoals() {
      const goals = Array.from(cells, cell => cell.innerText);

      try {
        localStorage.setItem(storageKey, JSON.stringify(goals));
        status.textContent = "✓ 자동 저장 완료";
      } catch (error) {
        status.textContent =
          "저장할 수 없어요. 브라우저 저장 설정을 확인해 주세요.";
      }
    }

    // 글자를 수정할 때마다 자동 저장
    cells.forEach(cell => {
      cell.addEventListener("input", saveGoals);

      // 여러 줄 대신 한 칸 안에서 편하게 수정
      cell.addEventListener("keydown", event => {
        if (event.key === "Enter") {
          event.preventDefault();
          cell.blur();
        }
      });
    });
  })();
</script>
